# Copy this file to .env and fill in the keys you need.
#   cp .env.example .env
# Never share or commit this file — it holds credentials.
# `hermes setup` can configure your main model provider for you; these
# variables are for anything you want to set up directly.

# --- Model provider (pick the one you use) ---
# The profile defaults to `openrouter` with `deepseek-v4-flash`.
# OpenRouter is preferred: one key unlocks a huge catalogue including
# free-tier models and multimodal (image, audio) models. Sign up at
# https://openrouter.ai/ — free models rotate month to month, so check
# the live catalogue for what is currently free.
# OPENROUTER_API_KEY=

# --- Alternative router: OrcaRouter (optional) ---
# A model gateway/router alternative to OpenRouter. Get a key at
# https://orcarouter.ai/ (docs: https://docs.orcarouter.ai/). The
# provider id is `orcarouter`; the model `orcarouter/auto` routes to
# the cheapest/live model.
# ORCAROUTER_API_KEY=

# --- Fallback provider (optional) ---
# If OpenRouter is unavailable, the profile falls back to opencode.
# OPENCODE_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Jina AI (web search + fetch, free tier) ---
# Sign up free at https://jina.ai/ — no credit card needed for the
# basic tier. Used by the Eight Essentials curriculum skill for
# research during lessons. Get your key from the Jina dashboard
# (https://jina.ai/ — "API Keys").
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Delivery channel (pick one) ---
# Telegram bot — easier, clearer, audio player renders inline.
# Create via @BotFather in Telegram (https://t.me/BotFather), then
# paste the token and your chat id below. Find your chat id by
# messaging @userinfobot (https://t.me/userinfobot).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# WhatsApp — only if your household uses WhatsApp and not Telegram.
# WhatsApp Business API via a BSP (Twilio, MessageBird, etc.), or a
# personal bridge like Baileys (Node.js). See setup-walkthrough skill.
# WHATSAPP_API_TOKEN=
# WHATSAPP_CHAT_ID=

# --- here.now (the student's multimedia space) ---
# here.now is where the student's creations go public: HTML lesson
# pages, images, audio (Morning Minute voice), and videos (music
# videos, storyboards). One API key covers all of it. Create an
# account and API key at https://here.now/ (dashboard → API keys).
# HERENOW_API_KEY=
# HERENOW_DRIVE_ID=

# --- Optional: other integrations the orientation may have set up ---
# Mnemosyne is profile-scoped and local-first; no key needed.
# Notion: NOTION_API_KEY=
# Google Workspace: see `gws` CLI auth flow, not env vars.
# GitHub: GITHUB_TOKEN=   (or use `gh auth login` instead)