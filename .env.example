# Copy this file to .env and fill in the keys you need.
#   cp .env.example .env
# Never share or commit this file — it holds credentials.
# `hermes setup` can configure your main model provider for you; these
# variables are for anything you want to set up directly.

# --- Model provider (pick the one you use) ---
# The profile defaults to `opencode` with `deepseek-v4-flash`.
# Add the key for whichever provider your `hermes setup` chose.
# OPENCODE_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Fallback provider (optional) ---
# If opencode is unavailable, the profile falls back to OpenRouter.
# OPENROUTER_API_KEY=

# --- Jina AI (web search + fetch, free tier) ---
# Sign up free at https://jina.ai/ — no credit card needed for the
# basic tier. Used by the Eight Essentials curriculum skill for
# research during lessons.
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Delivery channel (pick one) ---
# Telegram bot — easier, clearer, audio player renders inline.
# Create via @BotFather in Telegram, then paste the token and your
# chat id below.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# WhatsApp — only if your household uses WhatsApp and not Telegram.
# WhatsApp Business API via a BSP (Twilio, MessageBird, etc.), or a
# personal bridge like Baileys (Node.js). See setup-walkthrough skill.
# WHATSAPP_API_TOKEN=
# WHATSAPP_CHAT_ID=

# --- here.now drive (for public audio URLs) ---
# The Morning Minute audio is uploaded to here.now so Telegram or
# WhatsApp can render an inline audio player. Local Windows paths
# do not render.
# HERENOW_API_KEY=
# HERENOW_DRIVE_ID=

# --- Optional: other integrations the orientation may have set up ---
# Mnemosyne is profile-scoped and local-first; no key needed.
# Notion: NOTION_API_KEY=
# Google Workspace: see `gws` CLI auth flow, not env vars.
# GitHub: GITHUB_TOKEN=   (or use `gh auth login` instead)